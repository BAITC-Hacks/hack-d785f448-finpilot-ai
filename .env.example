# Скопируйте в .env (он в .gitignore). Реальные значения в Git не попадают.
# База — только внутри compose, наружу порт не публикуется.
POSTGRES_USER=graph
POSTGRES_PASSWORD=graph-local-only
POSTGRES_DB=graph
APP_PORT=8000

# Ассистент. Пусто — режим replay без сети (демо работает). Значение задаёт живую модель.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Только для запуска serve.py без Docker с локальной базой:
# DATABASE_URL=postgresql://graph:graph-local-only@localhost:5432/graph
